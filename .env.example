# ==================================================
# CONFIGURACIÓN DE LA APLICACIÓN
# ==================================================

# Nombre de la aplicación (aparecerá en el navegador y emails)
APP_NAME="BitgetTrade"

# Entorno de la aplicación (local, production, staging)
APP_ENV=local

# Clave de encriptación (genera una con: php artisan key:generate)
# IMPORTANTE: No compartas esta clave y genérala de nuevo en cada instalación
APP_KEY=

# Habilitar modo debug (true para desarrollo, false para producción)
APP_DEBUG=true

# URL de la aplicación (para desarrollo local)
APP_URL=http://localhost

# Configuración regional
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# Modo de mantenimiento
APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# Trabajadores del servidor CLI de PHP (descomentar si es necesario)
# PHP_CLI_SERVER_WORKERS=4

# Número de rondas de hash para bcrypt (mayor = más seguro pero más lento)
BCRYPT_ROUNDS=12

# ==================================================
# CONFIGURACIÓN DE LOGS
# ==================================================

# Canal de logging (single, stack, daily)
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ==================================================
# CONFIGURACIÓN DE BASE DE DATOS
# ==================================================

# SQLite es la configuración por defecto (sin instalación adicional)
DB_CONNECTION=sqlite

# Si prefieres MySQL/MariaDB, comenta SQLite y descomenta esto:
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=bitget_laravel
# DB_USERNAME=root
# DB_PASSWORD=

# ==================================================
# CONFIGURACIÓN DE SESIONES
# ==================================================

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# ==================================================
# CONFIGURACIÓN DE CACHÉ Y COLAS
# ==================================================

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database
# CACHE_PREFIX=

# ==================================================
# CONFIGURACIÓN DE MEMCACHED (opcional)
# ==================================================

MEMCACHED_HOST=127.0.0.1

# ==================================================
# CONFIGURACIÓN DE REDIS (opcional)
# ==================================================

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ==================================================
# CONFIGURACIÓN DE EMAIL
# ==================================================

# Para desarrollo, los emails se registran en los logs
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# ==================================================
# CONFIGURACIÓN DE AWS (opcional)
# ==================================================

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ==================================================
# CONFIGURACIÓN DE VITE (Frontend)
# ==================================================

VITE_APP_NAME="${APP_NAME}"

# ==================================================
# CONFIGURACIÓN DE BITGET API
# ==================================================
# ✅ IMPORTANTE: Las credenciales de Bitget ahora se gestionan desde la base de datos
#
# Ya NO es necesario configurar credenciales en este archivo .env
#
# Para agregar cuentas API de Bitget:
# 1. Inicia sesión en la aplicación
# 2. Ve a la sección "Cuentas API"
# 3. Haz clic en "Agregar Cuenta"
# 4. Ingresa tus credenciales de Bitget allí
#
# Cada usuario puede gestionar múltiples cuentas desde la interfaz web
# Las credenciales se almacenan de forma segura en la base de datos
# ==================================================
